<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox fx:controller="com.uam.paejavafxeventos.controller.PulperiaController" alignment="CENTER" spacing="20" prefHeight="400.0" prefWidth="600.0" styleClass="hub-root" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" >
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>
    <Label text="Inventario de Pulpería" styleClass="hub-titulo"/>
    <Label text="¿Qué deseas hacer?" styleClass="hub-subtitulo"/>
    <Button text="📦 Registrar producto" onAction="#irARegistrar" styleClass="hub-boton" maxWidth="Infinity"/>
    <Button text="🔍 Buscar producto" onAction="#irABuscar" styleClass="hub-boton" maxWidth="Infinity"/>
</VBox>
