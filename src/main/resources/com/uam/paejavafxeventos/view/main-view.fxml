<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="root-menu" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uam.paejavafxeventos.MainController">
    <padding>
        <Insets top="40.0" right="34.0" bottom="26.0" left="34.0"/>
    </padding>

    <Label styleClass="eyebrow" text="PROGRAMACIÓN DE APLICACIONES DE ESCRITORIO"/>
    <Label styleClass="titulo" text="Eventos y controles"/>
    <Label styleClass="subtitulo" text="Elige el reto que quieres ejecutar.">
        <VBox.margin>
            <Insets top="4.0"/>
        </VBox.margin>
    </Label>

    <VBox spacing="10.0">
        <VBox.margin>
            <Insets top="26.0"/>
        </VBox.margin>

        <Button styleClass="tarjeta" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY"
                onAction="#abrirPulperia">
            <graphic>
                <HBox spacing="16.0" alignment="CENTER_LEFT">
                    <Label styleClass="tarjeta-numero" text="01"/>
                    <VBox spacing="3.0">
                        <Label styleClass="tarjeta-titulo" text="Inventario de pulpería"/>
                        <Label styleClass="tarjeta-detalle" text="ActionEvent · KeyEvent"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

        <Button styleClass="tarjeta" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY"
                onAction="#abrirCafe">
            <graphic>
                <HBox spacing="16.0" alignment="CENTER_LEFT">
                    <Label styleClass="tarjeta-numero" text="02"/>
                    <VBox spacing="3.0">
                        <Label styleClass="tarjeta-titulo" text="Recepción de café"/>
                        <Label styleClass="tarjeta-detalle" text="MouseEvent · ContextMenu"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>

        <Button styleClass="tarjeta" maxWidth="Infinity" contentDisplay="GRAPHIC_ONLY"
                onAction="#abrirArtesanias">
            <graphic>
                <HBox spacing="16.0" alignment="CENTER_LEFT">
                    <Label styleClass="tarjeta-numero" text="03"/>
                    <VBox spacing="3.0">
                        <Label styleClass="tarjeta-titulo" text="Tienda de artesanías"/>
                        <Label styleClass="tarjeta-detalle" text="MenuBar · ToolBar"/>
                    </VBox>
                </HBox>
            </graphic>
        </Button>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Label styleClass="pie" text="Equipo Fedora · Guía práctica de eventos"/>
</VBox>
