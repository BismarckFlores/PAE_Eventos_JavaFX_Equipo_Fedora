<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.uam.paejavafxeventos.controller.PulperiaController" spacing="10" prefHeight="400.0" prefWidth="600.0" styleClass="pantalla-root" stylesheets="@../css/app.css">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>
    <Button text="← Volver" onAction="#volverAlHub" styleClass="boton-volver"/>
    <Label text="Registrar producto" styleClass="titulo-pantalla"/>
    <Label text="Presiona ENTER en cualquier campo para guardar" styleClass="ayuda"/>
    <Label text="Código:"/>
    <TextField fx:id="txtCodigo" onAction="#guardarProducto"/>
    <Label text="Nombre:"/>
    <TextField fx:id="txtNombre" onAction="#guardarProducto"/>
    <Label text="Precio:"/>
    <TextField fx:id="txtPrecio" onAction="#guardarProducto"/>
    <Label text="Cantidad:"/>
    <TextField fx:id="txtCantidad" onAction="#guardarProducto"/>
    <Label fx:id="lblMensaje" styleClass="mensaje"/>
</VBox>
